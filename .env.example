# 把本文件复制成 .env，填入真实值。.env 不会被提交到 Git。

# ---------- 对话模型（Agent 和评测都用它） ----------
LLM_API_KEY=

# 接口地址（OpenAI 兼容）
#   DeepSeek:      https://api.deepseek.com/v1
#   智谱 GLM:      https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
#   DeepSeek:      deepseek-chat
#   智谱 GLM:      glm-4-flash
LLM_MODEL=deepseek-chat


# ---------- Embedding（向量检索用，可选） ----------
# 单配一个的原因：DeepSeek 没有 embedding 接口。
# 写代码的模型和做检索的模型本来就不该绑死在同一个配置上。
#
# 不填也能跑 —— 检索会自动降级成纯 BM25 单路召回，其余功能不受影响。
# 想启用向量检索，填智谱的（有免费额度）：
#   EMBED_API_KEY=你的智谱key
#   EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   EMBED_MODEL=embedding-3
EMBED_API_KEY=
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_MODEL=embedding-3
